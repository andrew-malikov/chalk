{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2025 for iterator helpers used by the Bun runtime and canvas.
    "lib": ["ES2025"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@chalk/tutorial/assets/*": ["./packages/tutorial/assets/*"],
      "@chalk/tutorial/*": ["./packages/tutorial/src/*"],
      "@chalk/server/*": ["./packages/server/src/*"],
      "@chalk/mcp/*": ["./packages/mcp/src/*"],
      "@chalk/*": ["./packages/*/src"],
      // Source aliases; Vite and Vitest mirror them in scripts/test-config.ts.
      "@review/*": ["./packages/review/src/*"],
      "@cli/*": ["./packages/cli/src/*"],
      "@canvas/*": ["./apps/review-canvas/src/*"],
      "@shell/*": ["./apps/review-electrobun/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
