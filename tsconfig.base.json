{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2025 for iterator helpers used by the Bun runtime and canvas.
    "lib": ["ES2025"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@blackboard/*": ["./packages/*/src"],
      // Source aliases; Vite and Vitest mirror them in packages/review/test-config.ts.
      "@review/*": ["./packages/review/src/*"],
      "@canvas/*": ["./packages/review/app/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
