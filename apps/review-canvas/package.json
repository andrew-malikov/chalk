{
  "name": "@chalk/review-canvas",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "BUN_JSC_useFTLJIT=0 bunx --bun --no-install vp build --config desktop.vite.config.ts",
    "test": "BUN_JSC_useFTLJIT=0 bunx --bun --no-install vp test run --config vitest.config.ts",
    "test:node": "BUN_JSC_useFTLJIT=0 bunx --bun --no-install vp test run --config vitest.config.ts --project canvas-node",
    "test:browser": "BUN_JSC_useFTLJIT=0 bunx --bun --no-install vp test run --config vitest.config.ts --project browser",
    "test:browser:watch": "BUN_JSC_useFTLJIT=0 bunx --bun --no-install vp test watch --config vitest.config.ts --project browser --browser.headless=false",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/react-query": "5.106.1",
    "@xstate/react": "6.1.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "decode-named-character-reference": "1.3.0",
    "elkjs": "0.11.1",
    "katex": "0.18.7",
    "lucide-react": "1.70.0",
    "motion": "14.10.0",
    "prosekit": "0.22.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "xstate": "5.33.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chalk/server": "workspace:*",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "hono": "4.13.16",
    "jsdom": "29.1.1",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
