{
  "name": "@chalk/review-canvas",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "BUN_JSC_useFTLJIT=0 bun --bun run vite build --config desktop.vite.config.ts",
    "pretest": "bun run --filter @chalk/tutorial ensure:assets",
    "test": "BUN_JSC_useFTLJIT=0 bun --bun run vitest run --config vitest.config.ts",
    "test:node": "BUN_JSC_useFTLJIT=0 bun --bun run vitest run --config vitest.config.ts --project canvas-node",
    "test:browser": "BUN_JSC_useFTLJIT=0 bun --bun run vitest run --config vitest.config.ts --project browser",
    "test:browser:watch": "BUN_JSC_useFTLJIT=0 bun --bun run vitest --config vitest.config.ts --project browser --browser.headless=false",
    "typecheck": "bun --bun run tsc --noEmit -p .",
    "pretest:node": "bun run --filter @chalk/tutorial ensure:assets",
    "pretest:browser": "bun run --filter @chalk/tutorial ensure:assets",
    "pretypecheck": "bun run --filter @chalk/tutorial ensure:assets"
  },
  "dependencies": {
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@chalk/tutorial": "workspace:*",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@speed-highlight/core": "1.2.15",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.103.1",
    "@xstate/react": "6.1.0",
    "@xyflow/react": "12.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "decode-named-character-reference": "1.3.0",
    "elkjs": "0.11.1",
    "katex": "0.18.7",
    "lucide-react": "1.48.0",
    "prosekit": "0.22.3",
    "radix-ui": "1.6.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "xstate": "5.33.2",
    "zod": "catalog:",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chalk/server": "workspace:*",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "hono": "4.13.7",
    "jsdom": "29.1.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "unplugin": "2.3.11",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
