  "cards": [
    {
      "dot": "cyan",
      "title": "Author \u2192 save \u2192 display",
      "items": [
        "Agents discover a running instance, read its tool catalog and send edits over authenticated local HTTP.",
        "ReviewStore validates commands and write leases. Command IDs return saved receipts on identical retries.",
        "Accepted edits create saved versions; the canvas follows live snapshots and renders prose, diagrams and code links."
      ]
    },
    {
      "dot": "emerald",
      "title": "Read the code behind the review",
      "items": [
        "Reviews target saved working files, immutable commits, GitHub PRs or GitLab MRs.",
        "LocalReviewData reads Git source and prepares managed pinned checkouts when needed. diffr streams semantic changes.",
        "The desktop RPC opens referenced source in VS Code. Selecting text or code can start an ACP agent conversation."
      ]
    },
    {
      "dot": "violet",
      "title": "Optional paths and ownership",
      "items": [
        "Ask agents receive the same Blackboard MCP/CLI tools and can draw answers back onto the canvas. Chat history is saved locally.",
        "Trace loading uses configured storage. Sharing publishes a snapshot; later edits require another share.",
        "GitLab discussion actions are manual in Desktop. Shared and historical reviews cannot modify GitLab."
      ]
    }
  ]
