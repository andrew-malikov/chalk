{
  "name": "@chalk/mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. build:workspace-deps",
    "build": "bun --bun run tsdown",
    "test": "bunx --bun --no-install vp test run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@chalk/cli": "workspace:*",
    "@chalk/server": "workspace:*",
    "@types/node": "24.12.2",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
