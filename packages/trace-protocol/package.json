{
  "name": "@dev.fast/trace-protocol",
  "version": "0.5.0",
  "description": "Contract between the Blackboard CLI and the hosted trace store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/review.git",
    "directory": "packages/trace-protocol"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun --bun run tsc -p ../trace-protocol/tsconfig.build.json",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc -p ../trace-protocol/tsconfig.json --noEmit",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
