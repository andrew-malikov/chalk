{
  "name": "@chalk/server",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. build:workspace-deps && bun run --filter @chalk/tutorial ensure:assets",
    "build": "bun --bun run tsdown",
    "pretest": "bun run --filter @chalk/tutorial ensure:assets",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:integration:diffr": "bun run --cwd ../.. build:workspace-deps && bun --bun run vitest run --config vitest.integration.config.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@chalk/tutorial": "workspace:*",
    "@dev.fast/diffr": "0.1.20",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "pino-pretty": "13.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
