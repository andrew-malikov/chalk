{
  "name": "@chalk/server",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. build:workspace-deps",
    "build": "bun --bun run tsdown",
    "test": "bunx --bun --no-install vp test run --config vitest.config.ts",
    "test:integration:diffr": "bun run --cwd ../.. build:workspace-deps && bunx --bun --no-install vp test run --config vitest.integration.config.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@dev.fast/diffr": "0.1.23",
    "hono": "4.13.16",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "pino-pretty": "13.2.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
