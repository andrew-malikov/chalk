{
  "name": "@blackboard/review-protocol",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --bun run tsc -p ../review-protocol/tsconfig.build.json",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc -p ../review-protocol/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blackboard/json": "workspace:*",
    "@dev.fast/diffr": "0.1.10",
    "eventsource-parser": "3.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
