{
  "name": "@chalk/review",
  "version": "0.2.0",
  "private": true,
  "description": "Review document rules, authoring, persistence, and local integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrew-malikov/chalk.git",
    "directory": "packages/review"
  },
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bunx --bun --no-install vp test run --config vitest.config.ts",
    "test:node": "bunx --bun --no-install vp test run --config vitest.config.ts --project shared-module-graph",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/local-vcs": "^0.1.0",
    "@chalk/review-contracts": "workspace:*",
    "@dev.fast/diffr": "0.1.24",
    "@gitbeaker/rest": "44.0.3",
    "@img/sharp-wasm32": "0.35.5",
    "fuzzysort": "4.0.2",
    "isomorphic-git": "1.44.11",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
