{
  "name": "@blackboard/review",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/review.git",
    "directory": "packages/review"
  },
  "bin": {
    "blackboard": "./dist/cli.js",
    "review": "./dist/cli.js",
    "whiteboard": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "onboarding.md",
    "dist",
    "instructions",
    "tutorial",
    "!tutorial/.bundle",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*test-utils*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "bun run build:workspace-deps",
    "ensure:diffr": "diffr-fetch --into bin",
    "build": "bun --bun run tsdown",
    "build:tutorial-assets": "bun scripts/build-tutorial-assets.ts",
    "ensure:tutorial-assets": "bun scripts/ensure-tutorial-assets.ts",
    "check:tutorial": "bun scripts/check-tutorial.ts",
    "build:workspace-deps": "bun run --filter @blackboard/json --filter @blackboard/local-vcs build && bun run --filter @blackboard/review-protocol build",
    "pretypecheck": "bun run ensure:tutorial-assets",
    "pretest": "bun run ensure:tutorial-assets",
    "pretest:node": "bun run ensure:tutorial-assets",
    "prepack": "bun run build",
    "start": "bun src/cli.ts",
    "review": "bun src/cli.ts",
    "fixtures:capture-legacy-review": "bun scripts/capture-legacy-review-fixture.ts",
    "fixtures:legacy-review-goldens": "bun scripts/generate-legacy-review-goldens.ts",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:node": "bun --bun run vitest run --config vitest.config.ts --project shared-module-graph",
    "test:legacy-corpus": ": \"${REVIEW_LEGACY_CORPUS:?set REVIEW_LEGACY_CORPUS to a directory of legacy Review UUID folders}\" && bun --bun run vitest run --config vitest.config.ts src/review-import/legacy-review-corpus.test.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ../review",
    "test:integration:diffr": "bun run build:workspace-deps && bun run ensure:diffr --required && bun --bun run vitest run --config vitest.integration.config.ts",
    "blackboard": "bun src/cli.ts"
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "es-module-lexer": "2.1.0",
    "fuzzysort": "4.0.2",
    "hono": "4.13.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "pino": "10.3.1",
    "semver": "7.8.5",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blackboard/json": "workspace:*",
    "@blackboard/local-vcs": "^0.1.0",
    "@blackboard/review-protocol": "workspace:*",
    "@dev.fast/diffr": "0.1.10",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/semver": "7.7.1",
    "isomorphic-git": "1.38.10",
    "micromark-extension-math": "3.1.0",
    "pino-pretty": "13.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "intent": {
    "version": 1,
    "repo": "devdotfast/review",
    "docs": "packages/review/instructions/authoring.md"
  }
}
