{
  "name": "@blackboard/review",
  "version": "0.2.0",
  "private": true,
  "description": "Review document rules, authoring, persistence, and local integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/review.git",
    "directory": "packages/review"
  },
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:node": "bun --bun run vitest run --config vitest.config.ts --project shared-module-graph",
    "typecheck": "bun --bun run tsc --noEmit -p .",
    "ensure:diffr": "diffr-fetch --into bin"
  },
  "dependencies": {
    "@blackboard/json": "workspace:*",
    "@blackboard/local-vcs": "^0.1.0",
    "@blackboard/review-contracts": "workspace:*",
    "@dev.fast/diffr": "0.1.10",
    "@img/sharp-wasm32": "0.35.4",
    "fuzzysort": "4.0.2",
    "isomorphic-git": "1.38.10",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
