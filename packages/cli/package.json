{
  "name": "@chalk/cli",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewmalikov/chalk.git",
    "directory": "packages/cli"
  },
  "bin": {
    "chalk": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "instructions",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. build:workspace-deps",
    "build": "bun --bun run tsdown",
    "prepack": "bun run build",
    "start": "bun src/cli.ts",
    "review": "bun src/cli.ts",
    "chalk": "bun src/cli.ts",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "fuzzysort": "4.0.2",
    "hono": "4.13.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/local-vcs": "^0.1.0",
    "@chalk/mcp": "workspace:*",
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@chalk/server": "workspace:*",
    "@dev.fast/diffr": "0.1.20",
    "@types/node": "24.12.2",
    "isomorphic-git": "1.38.10",
    "micromark-extension-math": "3.1.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
