{
  "name": "@chalk/cli",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrew-malikov/chalk.git",
    "directory": "packages/cli"
  },
  "bin": {
    "chalk": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "instructions",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. build:workspace-deps",
    "build": "bun --bun run tsdown",
    "prepack": "bun run build",
    "start": "bun src/cli.ts",
    "review": "bun src/cli.ts",
    "chalk": "bun src/cli.ts",
    "test": "bunx --bun --no-install vp test run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc --noEmit -p ."
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "14.0.3",
    "fuzzysort": "4.0.2",
    "hono": "4.13.16",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chalk/json": "workspace:*",
    "@chalk/local-vcs": "^0.1.0",
    "@chalk/mcp": "workspace:*",
    "@chalk/review": "workspace:*",
    "@chalk/review-contracts": "workspace:*",
    "@chalk/server": "workspace:*",
    "@dev.fast/diffr": "0.1.23",
    "@types/node": "24.12.2",
    "isomorphic-git": "1.44.11",
    "micromark-extension-math": "3.1.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
