{
  "name": "@chalk/local-vcs",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --bun run tsdown",
    "prepack": "bun run build",
    "test": "bunx --bun --no-install vp test run --config vitest.config.ts",
    "typecheck": "bun --bun run tsc -p ../local-vcs/tsconfig.json --noEmit"
  },
  "dependencies": {
    "git-url-parse": "16.1.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/proper-lockfile": "4.1.4",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
