{
  "name": "@chalk/review-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Chalk desktop and CLI monorepo",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/agent-plugins/pi",
      "apps/*"
    ],
    "catalog": {
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "dev": "bun run desktop:dev",
    "clean": "bun scripts/clean-review-desktop.mjs",
    "desktop:build": "bun run --filter @chalk/review-electrobun app:build",
    "electrobun:dev": "bun run desktop:dev",
    "electrobun:build": "bun run desktop:build",
    "review": "bun run --filter @chalk/cli review",
    "format": "vp fmt --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"tests/acceptance/**/*.{ts,html,json}\" \"!apps/review-canvas/icons/chalk.icon/**\" \"*.json\" \".*.json\" vite.config.ts",
    "format:check": "vp fmt --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"tests/acceptance/**/*.{ts,html,json}\" \"!apps/review-canvas/icons/chalk.icon/**\" \"*.json\" \".*.json\" vite.config.ts",
    "lint": "vp lint --disable-nested-config .",
    "ci": "bun run desktop:build && bun run --filter @chalk/tutorial check && bun run lint && bun run format:check && bun run typecheck && bun run test",
    "pretest": "bun run --filter @chalk/tutorial ensure:assets",
    "test:acceptance": "BUN_JSC_useFTLJIT=0 bun --bun run bddgen --config tests/acceptance/playwright.config.ts && BUN_JSC_useFTLJIT=0 bun --bun run playwright test --config tests/acceptance/playwright.config.ts",
    "test": "bun test scripts && bun run --bun --filter '*' --filter '!@chalk/review-workspace' --if-present test && bun run test:acceptance",
    "pretypecheck": "bun run build:workspace-deps && bun run --filter @chalk/tutorial ensure:assets",
    "typecheck": "bun run --bun --filter '*' --filter '!@chalk/review-workspace' --if-present typecheck && bun run typecheck:acceptance",
    "typecheck:acceptance": "bun --bun run tsc --noEmit -p tests/acceptance",
    "build": "bun run desktop:build",
    "desktop:dev": "bun run --filter @chalk/review-electrobun app:dev",
    "build:workspace-deps": "bun run --filter @chalk/json --filter @chalk/local-vcs build && bun run --filter @chalk/review-contracts build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "24.12.2",
    "playwright-bdd": "9.2.1",
    "typescript": "npm:typescript@7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "zod": "catalog:"
  },
  "overrides": {
    "@chalk/local-vcs": "workspace:0.1.0",
    "esbuild": "0.28.1",
    "hono": "4.13.5",
    "postcss": "8.5.23",
    "undici": "7.29.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "elkjs@0.11.1": "patches/elkjs@0.11.1.patch"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
