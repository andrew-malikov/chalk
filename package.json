{
  "name": "@blackboard/review-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Blackboard desktop and CLI monorepo",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/agent-plugins/pi",
      "packages/review/app",
      "apps/*"
    ],
    "catalog": {
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "dev": "bun run desktop:dev",
    "clean": "bun scripts/clean-review-desktop.mjs",
    "desktop:build": "bun run --filter @blackboard/review-electrobun app:build",
    "electrobun:dev": "bun run desktop:dev",
    "electrobun:build": "bun run desktop:build",
    "review": "bun run --filter @blackboard/review review",
    "format": "oxfmt --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"!packages/review/app/icons/dev-fast.icon/**\" \"*.json\" \".*.json\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"!packages/review/app/icons/dev-fast.icon/**\" \"*.json\" \".*.json\"",
    "lint": "oxlint --disable-nested-config .",
    "ci": "bun run desktop:build && bun run --filter @blackboard/review check:tutorial && bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test": "bun test scripts && bun run --bun --filter '*' --filter '!@blackboard/review-workspace' --if-present test",
    "pretypecheck": "bun run --filter @blackboard/review build:workspace-deps",
    "typecheck": "bun run --bun --filter '*' --filter '!@blackboard/review-workspace' --if-present typecheck",
    "build": "bun run desktop:build",
    "desktop:dev": "bun run --filter @blackboard/review-electrobun app:dev"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "24.12.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "npm:typescript@7.0.2",
    "zod": "catalog:"
  },
  "overrides": {
    "@blackboard/local-vcs": "workspace:0.1.0",
    "esbuild": "0.28.1",
    "hono": "4.13.5",
    "postcss": "8.5.23",
    "undici": "7.29.0",
    "vite": "8.0.16"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "elkjs@0.11.1": "patches/elkjs@0.11.1.patch"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
